# =============================================================================
# Plantilla de entorno del caso de estudio CS1
#
# Copiar a .env y ajustar. Este archivo SI se versiona; .env no.
#
# Regla: aqui no va el valor de ninguna credencial, solo la ruta al archivo que
# la guarda dentro de keys/. Las variables sensibles terminan en _FILE.
# Los parametros de negocio y de modelo NO van aqui: viven en config/config.yaml.
# =============================================================================

# --- Entorno ------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# --- Rutas del proyecto -------------------------------------------------------
# Vacio significa "deducir de la ubicacion del paquete". Solo se rellena para
# apuntar a una raiz distinta, por ejemplo dentro de un contenedor.
FUEL_PRICE_GT_ROOT=
FUEL_PRICE_GT_CONFIG=

# --- Base de datos ------------------------------------------------------------
# Motor embebido por defecto: es un archivo, no necesita servicio.
DATABASE_URL=sqlite+pysqlite:///data/fuel-prices.db

# --- Fuente de imagenes -------------------------------------------------------
# manifest | gdrive-public | gdrive | object-store | local
# Ver docs/07_image_source.md para elegir. En resumen: 'manifest' es una lista
# de direcciones y no necesita credencial; las de Drive recorren la carpeta y
# si la necesitan.
# Sin credenciales configuradas siempre cae a local, para que la integracion
# continua funcione en ramas sin acceso.
IMAGE_SOURCE=local

# Solo para IMAGE_SOURCE=manifest: archivo o direccion con la lista
IMAGE_MANIFEST=
IMAGE_RAW_DIR=data/raw
IMAGE_INTERIM_DIR=data/interim
IMAGE_CACHE_DIR=data/raw

# --- Modelos ------------------------------------------------------------------
MODELS_DIR=models

# --- Puertos ------------------------------------------------------------------
# Rango reservado del proyecto: 19000-19099. Elegido por debajo de 32768, donde
# el sistema empieza a asignar puertos efimeros por su cuenta, y fuera de los
# puertos habituales de desarrollo (3000, 5000, 5432, 8000, 8080, 27017).
API_PORT=19010
DB_PORT=19020
DB_BROWSER_PORT=19030
OBJECT_STORE_PORT=19040
OBJECT_STORE_CONSOLE_PORT=19041

# --- Google Drive -------------------------------------------------------------
# Hay dos vias, y la eleccion no es tecnica sino sobre quien puede ver las
# fotografias. Se elige con IMAGE_SOURCE:
#
#   gdrive-public  carpeta compartida por enlace + clave de API. Menos pasos de
#                  configuracion, a cambio de que la carpeta quede accesible a
#                  quien tenga el enlace.
#   gdrive         carpeta privada + cuenta de servicio. Mas pasos, y deja
#                  constancia de quien tiene acceso.
#
# El identificador de carpeta no da acceso por si solo, asi que vive aqui. Lo
# que si da acceso vive en keys/, y aqui solo su ruta.
GDRIVE_FOLDER_ID=

# Para la via por enlace
GDRIVE_API_KEY_FILE=keys/gdrive-api.key

# Para la via con cuenta de servicio
GDRIVE_CREDENTIALS_FILE=keys/google-drive-service-account.json

# --- Almacenamiento de objetos ------------------------------------------------
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_BUCKET=
OBJECT_STORE_REGION=
OBJECT_STORE_CREDENTIALS_FILE=keys/object-store.env

# --- Publicacion del paquete --------------------------------------------------
PACKAGE_INDEX_URL=https://test.pypi.org/legacy/
PACKAGE_INDEX_TOKEN_FILE=keys/testpypi-api.key

# --- Modelos de terceros ------------------------------------------------------
# Solo si se usa un modelo de acceso restringido. Hoy no hace falta.
HF_TOKEN_FILE=keys/huggingface.key
