models/*
!models/.gitkeep

output/*
!output/.gitkeep

# Los .jsonl de cada corrida son artefactos, no fuente
logs/*
!logs/.gitkeep

# Ignorar todo el contenido de data
data/**

# Mantener las carpetas mediante .gitkeep
!data/.gitkeep
!data/raw/
!data/raw/.gitkeep

# Imagenes HEIC de entrada
*.heic
*.HEIC

# Las cinco fotografias piloto son datos versionados del caso de estudio.
!datos/*.heic
!datos/*.HEIC

imageConvert/__pycache__/
imageConvert/output/*
!imageConvert/output/.gitkeep

# __pycache__/
__pycache__/

# environment
venv/
.venv/

# Artefactos reproducibles del pipeline MLOps
datos_procesados/
reports/
.venv-ci/
.ruff_cache/
.pytest_cache/
